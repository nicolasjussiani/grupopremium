# Django
# Gere uma chave longa e exclusiva para cada ambiente.
SECRET_KEY=replace-with-a-random-secret-key-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Na Vercel, os dominios informados pelas variaveis VERCEL_* sao incluidos
# automaticamente. Acrescente dominios personalizados nas duas listas acima.
SECURE_SSL_REDIRECT=False

# Banco de dados (obrigatorio em ambientes serverless/producao)
DATABASE_URL=

# Supabase API (opcional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Supabase Storage S3 (opcional)
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=arquivos
SUPABASE_S3_REGION_NAME=us-east-1

# Integracoes opcionais
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CEO_CHAT_ID=
TELEGRAM_TOKEN_RECRUTAMENTO=
TELEGRAM_TOKEN_ADMISSIONAL=
TELEGRAM_TOKEN_ADMINISTRATIVO=
TELEGRAM_TOKEN_SESMET=
TELEGRAM_CHAT_ID_RECRUTAMENTO=
TELEGRAM_CHAT_ID_ADMISSIONAL=
TELEGRAM_CHAT_ID_ADMINISTRATIVO=
TELEGRAM_CHAT_ID_SESMET=

# Somente para dados demonstrativos locais
ALLOW_DEMO_SEED=False
SEED_DEFAULT_PASSWORD=
